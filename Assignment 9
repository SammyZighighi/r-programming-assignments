data("iris", package = "datasets")
head(iris)
str(iris)

install.packages("lattice")
install.packages("ggplot2")

library(lattice)
library(ggplot2)

# Base R Graphics

png("base_scatter.png", width = 800, height = 600)

plot(iris$Sepal.Length, iris$Petal.Length,
     main = "Base R: Sepal Length vs. Petal Length",
     xlab = "Sepal Length",
     ylab = "Petal Length",
     pch = 19,
     col = as.numeric(iris$Species))

legend("topleft",
       legend = levels(iris$Species),
       col = 1:3,
       pch = 19)

dev.off()

hist(iris$Sepal.Length,
     main = "Base R: Sepal Length Distribution",
     xlab = "Sepal Length",
     col = "lightblue",
     border = "white")

# Lattice Graphics

png("lattice_scatter.png", width = 800, height = 600)

print(xyplot(Petal.Length ~ Sepal.Length | Species,
             data = iris,
             main = "Lattice: Sepal Length vs. Petal Length",
             xlab = "Sepal Length",
             ylab = "Petal Length",
             pch = 19))

dev.off()

bwplot(Sepal.Length ~ Species,
       data = iris,
       main = "Lattice: Sepal Length by Species",
       xlab = "Species",
       ylab = "Sepal Length",
       col = "lightblue")

# ggplot2

ggplot(iris, aes(x = Sepal.Length,
                 y = Petal.Length,
                 color = Species)) +
  geom_point(size = 2) +
  geom_smooth(method = "lm", se = FALSE) +
  labs(title = "ggplot2: Sepal Length vs. Petal Length",
       x = "Sepal Length",
       y = "Petal Length",
       color = "Species") +
  theme_minimal()

ggplot(iris, aes(x = Sepal.Length, fill = Species)) +
  geom_histogram(binwidth = 0.3,
                 color = "white",
                 alpha = 0.8) +
  facet_wrap(~ Species) +
  labs(title = "ggplot2: Sepal Length Distribution by Species",
       x = "Sepal Length",
       y = "Count") +
  theme_minimal()
