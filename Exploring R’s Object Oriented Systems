# 3. Create an S3 Object


s3_obj <- list(name = "Myself", age = 29, GPA = 3.5)
class(s3_obj) <- "student_s3"

# Define a custom S3 print method
print.student_s3 <- function(x, ...) {
  cat("S3 Student Object\n")
  cat("Name:", x$name, "\n")
  cat("Age:", x$age, "\n")
  cat("GPA:", x$GPA, "\n")
}

# Test S3 method dispatch
print(s3_obj)

# Inspect the S3 object
class(s3_obj)
typeof(s3_obj)
isS4(s3_obj)


# 4. Create an S4 Class and Object


setClass("student_s4",
         slots = c(
           name = "character",
           age = "numeric",
           GPA = "numeric"
         ))

s4_obj <- new("student_s4",
              name = "Myself",
              age = 29,
              GPA = 3.5)

# Define a custom S4 print method
setMethod("show", "student_s4",
          function(object) {
            cat("S4 Student Object\n")
            cat("Name:", object@name, "\n")
            cat("Age:", object@age, "\n")
            cat("GPA:", object@GPA, "\n")
          })

# Test S4 method dispatch
show(s4_obj)

# Inspect the S4 object
class(s4_obj)
isS4(s4_obj)
typeof(s4_obj)

# View the S4 object's slots
slotNames(s4_obj)


# 5. Compare S3 and S4


# S3 uses a class attribute and generic method dispatch
class(s3_obj)
attributes(s3_obj)

# S4 uses formal class definitions and slots
isClass("student_s4")
getClass("student_s4")
slotNames(s4_obj)
