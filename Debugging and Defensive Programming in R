tukey.outlier <- function(x) {
  q <- quantile(x, c(0.25, 0.75))
  iqr <- IQR(x)
  x < (q[1] - 1.5 * iqr) | x > (q[2] + 1.5 * iqr)
}

tukey_multiple <- function(x) {
  outliers <- array(TRUE, dim = dim(x))
  for (j in 1:ncol(x)) {
    outliers[, j] <- outliers[, j] && tukey.outlier(x[, j])
  }
  outlier.vec <- vector("logical", length = nrow(x))
  for (i in 1:nrow(x)) {
    outlier.vec[i] <- all(outliers[i, ])
  }
  return(outlier.vec)
}

set.seed(123)
test_mat <- matrix(rnorm(50), nrow = 10)

tryCatch(
  tukey_multiple(test_mat),
  error = function(e) message("Original error: ", conditionMessage(e))
)

corrected_tukey <- function(x) {
  if (!is.matrix(x) || !is.numeric(x)) {
    stop("Input must be a numeric matrix.")
  }
  
  if (nrow(x) == 0 || ncol(x) == 0) {
    stop("Matrix must have at least one row and column.")
  }
  
  if (anyNA(x) || any(!is.finite(x))) {
    stop("Matrix must contain only finite numeric values.")
  }
  
  outliers <- array(TRUE, dim = dim(x))
  for (j in seq_len(ncol(x))) {
    outliers[, j] <- outliers[, j] & tukey.outlier(x[, j])
  }
  
  outlier.vec <- logical(nrow(x))
  for (i in seq_len(nrow(x))) {
    outlier.vec[i] <- all(outliers[i, ])
  }
  
  outlier.vec
}

result <- corrected_tukey(test_mat)
print(result)

stopifnot(is.logical(result))
stopifnot(length(result) == 10)
